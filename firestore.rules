rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function myDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myRole() { return myDoc().data.role; }
    function isActive() { return myDoc().data.actif == true; }
    function isAdmin() { return isAuth() && isActive() && myRole() == 'admin'; }

    // ── users ── RG-01 : création publique => role client uniquement
    match /users/{uid} {
      allow read: if isAuth() && isActive();
      allow create: if isAuth()
                    && request.resource.data.role == 'client'
                    && request.resource.data.actif == true;
      allow update: if isAuth() && isActive()
                    && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ── products ── vendeur/admin uniquement en écriture
    match /products/{id} {
      allow read: if isAuth() && isActive();
      allow create: if isAuth() && isActive()
                    && myRole() in ['vendeur', 'admin']
                    && request.resource.data.vendeurId == request.auth.uid;
      allow update, delete: if isAuth() && isActive()
                    && (resource.data.vendeurId == request.auth.uid || isAdmin());
    }

    // ── orders ──
    match /orders/{id} {
      allow read: if isAuth() && isActive();
      allow create: if isAuth() && isActive()
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.statut == 'enAttente';
      // RG-03..RG-06 : transitions contrôlées côté client + vérifiées ici partiellement
      allow update: if isAuth() && isActive() && (
        isAdmin()
        || resource.data.clientId == request.auth.uid
        || resource.data.vendeurId == request.auth.uid
        || resource.data.livreurId == request.auth.uid
        || (resource.data.livreurId == null && request.resource.data.livreurId == request.auth.uid) // RG-05 assignation
      );
      allow delete: if isAdmin();
    }
  }
}
